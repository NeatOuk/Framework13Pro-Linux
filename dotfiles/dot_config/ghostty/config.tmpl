# Ghostty (Settings → fw13 → Terminal). Same look as kitty.conf; colours come from the generated theme file.
font-family = JetBrains Mono
font-size = 11.5
window-padding-x = 14
window-padding-y = 14
window-decoration = none
confirm-close-surface = false
background-opacity = 0.9

# Same as kitty.conf: splits instead of tabs, in the current folder (split-inherit-working-directory is on by default).
# Ctrl+Shift+T / Enter split the current pane; Ctrl+Shift+L shows one pane full size (kitty's "stack") and back.
keybind = ctrl+shift+t=new_split:auto
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+l=toggle_split_zoom

# Colours: written by fw13.theme ("?" = no error while it doesn't exist yet)
config-file = ?{{ .chezmoi.homeDir }}/.config/fw13/theme/ghostty
