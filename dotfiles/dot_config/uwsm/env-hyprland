# Sourced (shell) by uwsm for the Hyprland session only, exported to systemd --user and unset again when the
# session stops, so GNOME/KDE sessions on the same account keep their own Qt platform theme (KDE's in Plasma).
# Hyprland-only settings go here; environment.d/ is read by every session.
#
# Qt apps use qt6ct, which reads ~/.config/qt6ct/qt6ct.conf → the fw13 palette (~/.config/fw13/theme/qt6ct-colors.conf,
# Settings → Appearance). Read by Qt at app start; a change to this line needs a re-login.
export QT_QPA_PLATFORMTHEME=qt6ct

# GNOME's apps (and entries meant only for other desktops) hidden from the launcher in Hyprland: fw13.defaultapps
# writes NoDisplay copies here at each login. fuzzel ignores NotShowIn/OnlyShowIn, and ~/.local/share/applications
# would hide them in GNOME too, so this dir is on the data path for the Hyprland session only. Needs a re-login.
export XDG_DATA_DIRS="$HOME/.local/share/fw13/hyprland:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# 256/truecolour terminal tools use kitty's 16 colours (the fw13 palette, recoloured live on a theme change)
# instead of their own built-in schemes. Only when not set already (e.g. by the user's shell profile).
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:---color=16}"
export BAT_THEME="${BAT_THEME:-ansi}"

# Our helpers (~/.local/bin: fw-*, claude) and mise's tools on PATH. uwsm exports the login shell's PATH to the
# session, which replaces the one from environment.d/10-session.conf; a display manager that starts the session
# through a login shell (GDM) adds these, greetd's plain shell doesn't — then every fw-* key and autostart failed.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH" ;; esac

# SSH agent: Fedora's gcr-ssh-agent socket (enabled by run_onchange_after_session-services; GNOME sets the same path
# itself). Only when the socket exists and nothing else (the user's own agent) is set. Needs a re-login.
if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -S "$XDG_RUNTIME_DIR/gcr/ssh" ]; then export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/gcr/ssh"; fi
