{
  // Clean minimal bar: launcher + workspaces | clock | tray + status
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,
  "modules-left": ["custom/menu", "hyprland/workspaces"],
  "modules-center": ["clock", "custom/recording"],
  "modules-right": ["tray", "bluetooth", "network", "pulseaudio", "custom/display", "cpu", "battery", "custom/control", "custom/power"],

  "custom/menu": { "format": "", "on-click": "fw-menu-anchor launcher >/dev/null && fuzzel --anchor top-left --keyboard-focus=on-demand --no-exit-on-keyboard-focus-loss --launch-prefix='uwsm app -- '", "on-click-right": "uwsm app -- kitty", "tooltip": false },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": { "default": "○", "active": "●" },
    "persistent-workspaces": { "*": 5 }
  },
  "clock": {
    "format": "{:%A %H:%M}",
    "format-alt": "{:%d %B W%V %Y}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/recording": {
    "exec": "pgrep -x wf-recorder >/dev/null && echo ' REC' || echo ''",
    "interval": 2,
    "on-click": "fw-record"
  },
  "tray": { "spacing": 12 },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": " {num_connections}",
    "on-click": "FW_BAR=1 fw-control-center bluetooth",
    "on-click-right": "uwsm app -- blueman-manager"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) {ipaddr}",
    "on-click": "FW_BAR=1 fw-control-center wifi",
    "on-click-right": "uwsm app -- nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": { "default": ["", "", ""] },
    "tooltip-format": "{desc} {volume}%",
    "on-click": "FW_BAR=1 fw-control-center volume",
    "on-click-middle": "uwsm app -- pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },
  "custom/display": { "format": "", "tooltip-format": "Display", "on-click": "FW_BAR=1 fw-display-panel", "on-scroll-up": "brightnessctl -q set 5%+", "on-scroll-down": "brightnessctl -q set 5%-" },
  "cpu": { "format": "", "tooltip": true, "on-click": "uwsm app -- kitty --class fw-btop -e btop" },
  "battery": {
    "states": { "warning": 20, "critical": 10 },
    "format": "{icon}",
    "format-charging": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{capacity}% · {timeTo}",
    "on-click": "FW_BAR=1 fw-power-panel",
    "on-click-right": "FW_BAR=1 fw-system-menu"
  },
  "custom/control": { "format": "", "tooltip-format": "Control center", "on-click": "FW_BAR=1 fw-control-center" },
  "custom/power": { "format": "", "tooltip-format": "Lock / Suspend / Shut down", "on-click": "FW_BAR=1 fw-system-menu" }
}
