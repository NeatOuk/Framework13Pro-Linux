# restic environment — generated by chezmoi, not in git. Change it in Settings → fw13 (chezmoi.toml [data.restic] and, for s3:, [data.restic_creds]).
RESTIC_REPOSITORY={{ .restic.repository }}
RESTIC_PASSWORD={{ .restic.password }}
{{- if hasPrefix "s3:" .restic.repository }}
{{- with dig "restic_creds" "aws_access_key_id" "" . }}
AWS_ACCESS_KEY_ID={{ . }}
{{- end }}
{{- with dig "restic_creds" "aws_secret_access_key" "" . }}
AWS_SECRET_ACCESS_KEY={{ . }}
{{- end }}
{{- with dig "restic_creds" "aws_default_region" "" . }}
AWS_DEFAULT_REGION={{ . }}
{{- end }}
{{- end }}
