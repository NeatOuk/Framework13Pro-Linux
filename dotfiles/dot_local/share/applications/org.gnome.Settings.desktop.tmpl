{{- if lookPath "gnome-control-center" -}}
[Desktop Entry]
# Overrides /usr/share/applications/org.gnome.Settings.desktop: GNOME Settings exits outside GNOME
# ("only supported under GNOME and Unity"), so pretend to be GNOME. Wi-Fi, Bluetooth, Sound, Printers,
# Users, Date & Time work under Hyprland; Displays/Keyboard/Mouse don't (use the bar's panels).
Name=Settings
Comment=GNOME Settings (Wi-Fi, Bluetooth, Sound, Printers, Users, Date & Time)
Icon=org.gnome.Settings
Exec=env XDG_CURRENT_DESKTOP=GNOME gnome-control-center
Terminal=false
Type=Application
StartupNotify=true
Categories=GTK;Settings;
Keywords=Preferences;Settings;
{{- end }}
