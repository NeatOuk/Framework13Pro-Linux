#!/usr/bin/env python3
"""Jarvis panel (SUPER+A): type a question, the answer streams in right here.

Inline answers are read-only: the agent runs one-shot (`claude -p`, or `opencode run` for an Ollama server set up in
the OpenCode panel) in ~/jarvis, whose AGENTS.md briefs it on this OS, and may only read files and run
read-only commands. When something needs changing, "Continue in terminal" reopens the same conversation as a full
session (`claude --resume <id>` / `opencode -c`), where every change is asked for and root actions are explained
first. The other Jarvis actions are buttons: Work on repo (with what you typed), Diagnose last crash, Open Claude or
OpenCode — they go through `fw-jarvis` like before.

  fw-jarvis-panel            open (a second call closes it); Esc closes and stops a running answer
  fw-jarvis-panel --ask "…"  open with that question and answer it at once (crash notification → Diagnose)
GTK3 + gtk-layer-shell, like fw-warp-panel. Colours from fw13.ui_theme.
"""
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.expanduser("~/.local/lib"))

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, Pango  # noqa: E402

from fw13 import jarvis as jcfg, ui_theme  # noqa: E402
from fw13.hypr import hj  # noqa: E402
from fw13.ui_theme import button, label  # noqa: E402

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PIDFILE = os.path.join(RUNTIME, "fw-jarvis-panel.pid")
JDIR = os.path.expanduser("~/jarvis")
os.makedirs(JDIR, exist_ok=True)  # the working folder of every Jarvis agent run; chezmoi adds its AGENTS.md/CLAUDE.md
PANEL_W = 680
TOP_MARGIN = 60    # below the bar's exclusive zone
BOTTOM_GAP = 20    # space left under the panel
MIN_ANSWER = 80    # the answer keeps at least this much, even when a card fills the rest
OUTPUT_MAX = 160   # a Run card's command output scrolls past this

# What the inline agent may do without asking (one-shot mode can't ask): read anywhere (--add-dir /) except the
# secret files below, search, and read-only commands, including a few read-only ones as root through passwordless
# sudo (`sudo -n` fails cleanly where that isn't set up; root action cards go through pkexec instead). No cat/head/tail/grep in Bash: they would get around the
# Read denials, and the Read/Grep tools do the same job.
READ_ONLY_TOOLS = ["Read", "Grep", "Glob", "LS",
                   "Bash(journalctl:*)", "Bash(coredumpctl:*)", "Bash(systemctl status:*)",
                   "Bash(systemctl --user status:*)", "Bash(systemctl list-units:*)", "Bash(systemctl list-timers:*)",
                   "Bash(systemctl is-active:*)", "Bash(rpm -q:*)", "Bash(dnf list:*)", "Bash(dnf info:*)",
                   "Bash(ls:*)", "Bash(uname:*)", "Bash(lsblk:*)", "Bash(df:*)", "Bash(du:*)", "Bash(free:*)",
                   "Bash(ip addr:*)", "Bash(nmcli:*)", "Bash(hyprctl:*)", "Bash(fwupdmgr get-:*)", "Bash(sensors:*)",
                   "Bash(upower:*)", "Bash(lspci:*)", "Bash(lsusb:*)", "Bash(git -C:*)", "Bash(flatpak list:*)",
                   "Bash(sudo -n timeshift --list:*)", "Bash(sudo -n journalctl:*)", "Bash(sudo -n dmesg:*)",
                   "Bash(sudo -n smartctl -a:*)", "Bash(sudo -n smartctl -H:*)", "Bash(sudo -n nvme smart-log:*)",
                   "Bash(fw-hwcheck)", "Bash(fw-hwcheck --json)", "Bash(fw-health --json)", "Bash(fw-health --last)"]
# Never read inline, even though everything else is readable: keys and passwords.
SECRET_READS = ["Read(~/.config/chezmoi/**)", "Read(~/.config/restic/**)", "Read(~/.config/environment.d/**)",
                "Read(~/.ssh/**)", "Read(~/.gnupg/**)", "Read(~/.local/share/keyrings/**)",
                "Read(~/.config/chromium/**)", "Read(~/.mozilla/**)", "Read(~/.config/gh/**)",
                "Read(~/.claude.json)", "Read(~/.claude/.credentials.json)", "Read(//etc/shadow)",
                "Read(//etc/gshadow)", "Read(//etc/sudoers.d/**)", "Read(//etc/NetworkManager/system-connections/**)",
                "Grep(~/.config/chezmoi/**)", "Grep(~/.config/restic/**)", "Grep(~/.config/environment.d/**)",
                "Grep(~/.ssh/**)", "Grep(//etc/NetworkManager/system-connections/**)"]
INLINE_NOTE = ("You are answering inline in Jarvis's small panel. Be brief and practical: short paragraphs, short "
               "lists, commands in code blocks. You can only read here — never change anything. You may read files "
               "anywhere (key and password files are blocked) and run the allowed read-only commands; for root-only "
               "facts use `sudo -n timeshift --list`, `sudo -n journalctl`, `sudo -n dmesg` or `sudo -n smartctl`. "
               "When a fix needs a change, never run it yourself: propose ONE step as an action card and stop. "
               "The owner sees a Run button; if they press it, you get the command's output and can propose the "
               "next step. An action card is exactly one fenced block:\n"
               "```jarvis-action\n"
               "{\"title\": \"short title\", \"command\": \"the exact single shell command\", "
               "\"why\": \"what it's for\", \"how\": \"what it changes, and how to undo it\", "
               "\"root\": false}\n"
               "```\n"
               "Use plain `sudo` inside the command for root steps and set root to true (the panel runs root cards "
               "through pkexec, which asks the owner to authenticate). One command per card, no "
               "interactive programs, nothing that needs a terminal. Bigger jobs (edits across files, many steps) "
               "belong in \"Continue in terminal\": say so instead of proposing cards.\n"
               "After an answer that proposes no action card, you may end with exactly one block of 2 or 3 short "
               "questions (under 60 characters, in the owner's language) the owner is likely to ask next; they "
               "become buttons:\n"
               "```jarvis-followups\n"
               "[\"first question?\", \"second question?\"]\n"
               "```\n"
               "Leave it out when nothing useful comes next.")
ACTION_RE = re.compile(r"```jarvis-action[ \t]*\n(.*?)(?:\n```|\Z)", re.S)
FOLLOWUPS_RE = re.compile(r"```jarvis-followups[ \t]*\n(.*?)(?:\n```|\Z)", re.S)
MAX_CHIPS = 3
DANGER_RE = re.compile(r"\brm\s+-[a-zA-Z]*[rf]|\bdd\b|\bmkfs|\bwipefs\b|--force\b|\bshred\b|>\s*/dev/sd|\bfdisk\b"
                       r"|\bparted\b|\bchmod\s+-R\b|\bchown\s+-R\b|\bdnf\s+(remove|erase)\b")
RUN_TIMEOUT = 120
ROOT_TIMEOUT = 300   # includes the time the owner takes at the polkit prompt
SUDO_RE = re.compile(r"\bsudo(?:\s+-n)?\s+")


def root_argv(cmd):
    """Root cards run under pkexec (polkit prompt: password or fingerprint), so `sudo` inside is dropped."""
    return ["pkexec", "bash", "-c", SUDO_RE.sub("", cmd)]


def close_running():
    try:
        pid = int(open(PIDFILE).read())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if b"fw-jarvis-panel" not in f.read():
                return False
        os.kill(pid, signal.SIGTERM)
        return True
    except (OSError, ValueError):
        return False


def close_pidfile(name):
    path = os.path.join(RUNTIME, f"{name}.pid")
    try:
        pid = int(open(path).read())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if name.encode() in f.read():
                os.kill(pid, signal.SIGTERM)
    except (OSError, ValueError):
        pass


def screen_room():
    """(width, height) the panel may use on the focused screen, in logical px: rotation, scale, the bar's reserved
    space and the panel's own margins taken off."""
    try:
        m = next(m for m in hj("monitors") if m["focused"])
        w, h = m["width"] / m["scale"], m["height"] / m["scale"]
        if m.get("transform", 0) % 2:  # 90°/270° (and their flipped forms): width and height swap
            w, h = h, w
        left, top, right, bottom = (m.get("reserved") or [0, 0, 0, 0])[:4]
        return int(w - left - right - 32), int(h - top - bottom - TOP_MARGIN - BOTTOM_GAP)
    except (ValueError, KeyError, TypeError, StopIteration):
        return PANEL_W, 600


def agents():
    """[(label, target)]: Claude, then the OpenCode servers with a chosen model (fw-opencode --list)."""
    out = [("Claude", "claude")]
    try:
        r = subprocess.run(["fw-opencode", "--list"], capture_output=True, text=True, timeout=5)
        for line in r.stdout.splitlines():
            if "\t" in line:
                lbl, target = line.split("\t", 1)
                out.append((lbl, target))
    except (OSError, subprocess.TimeoutExpired):
        pass
    return out


def launch(*cmd, cwd=None):
    subprocess.Popen(["uwsm", "app", "--", *cmd], cwd=cwd, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---- Markdown (the subset agents use) → Pango markup --------------------------------------------------------
def _inline(text):
    t = GLib.markup_escape_text(text)
    t = re.sub(r"`([^`]+)`", r'<tt>\1</tt>', t)
    t = re.sub(r"\*\*([^*]+)\*\*", r"<b>\1</b>", t)
    t = re.sub(r"(?<![\w*])\*([^*\n]+)\*(?![\w*])", r"<i>\1</i>", t)
    t = re.sub(r"\[([^\]]+)\]\((https?://[^)\s]+)\)", r'\1 (<u>\2</u>)', t)
    return t


def markdown_to_pango(md):
    out, code = [], None
    for line in md.split("\n"):
        if line.strip().startswith("```"):
            if code is None:
                code = []
            else:
                out.append('<tt><span alpha="85%">' + GLib.markup_escape_text("\n".join(code)) + "</span></tt>")
                code = None
            continue
        if code is not None:
            code.append(line)
            continue
        m = re.match(r"^(#{1,6})\s+(.*)", line)
        if m:
            out.append(f"<b>{_inline(m.group(2))}</b>")
            continue
        m = re.match(r"^(\s*)[-*+]\s+(.*)", line)
        if m:
            out.append(f"{m.group(1)}• {_inline(m.group(2))}")
            continue
        out.append(_inline(line))
    if code is not None:  # still streaming a code block
        out.append('<tt><span alpha="85%">' + GLib.markup_escape_text("\n".join(code)) + "</span></tt>")
    return "\n".join(out)


def parse_followups(text):
    """Suggested next questions from a complete jarvis-followups block in `text` (at most MAX_CHIPS strings)."""
    for m in FOLLOWUPS_RE.finditer(text):
        if not m.group(0).rstrip().endswith("```"):
            continue  # cut off
        try:
            items = json.loads(m.group(1))
        except ValueError:
            continue
        if isinstance(items, list):
            return [q.strip() for q in items if isinstance(q, str) and q.strip()][:MAX_CHIPS]
    return []


def parse_actions(text):
    """Complete jarvis-action blocks in `text` → [{title, command, why, how, root}] (malformed ones skipped)."""
    out = []
    for m in ACTION_RE.finditer(text):
        if not m.group(0).rstrip().endswith("```"):
            continue  # cut off
        try:
            a = json.loads(m.group(1))
        except ValueError:
            continue
        cmd = str(a.get("command") or "").strip()
        if not cmd or "\n" in cmd:
            continue
        out.append({"title": str(a.get("title") or "Proposed step"), "command": cmd,
                    "why": str(a.get("why") or "—"), "how": str(a.get("how") or "—"),
                    "root": bool(a.get("root")) or cmd.startswith("sudo") or " sudo " in cmd})
    return out


class Panel(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.get_style_context().add_class("panel")
        room_w, self.max_h = screen_room()
        self.w = max(min(PANEL_W, room_w), 320)
        self.fit_queued = False
        self.set_size_request(self.w, -1)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "fw-jarvis-panel")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        # on-demand like the bar menus: the Ask box gets the keyboard at once, other windows can still be clicked
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, TOP_MARGIN)
        self.connect("key-press-event", self.on_key)

        self.proc = None
        self.session = None      # Claude session id of the last answer (Continue resumes it)
        self.last_target = None
        self.answer = ""
        self.started = 0.0

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        for side in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{side}")(14)

        head = Gtk.Box(spacing=10)
        head.pack_start(label("Jarvis", "title"), True, True, 0)
        self.agent = Gtk.ComboBoxText()
        self.targets = agents()
        for lbl, target in self.targets:
            self.agent.append(target, lbl)
        self.agent.set_active(0)
        if len(self.targets) > 1:
            head.pack_end(self.agent, False, False, 0)
        box.pack_start(head, False, False, 0)

        self.entry = Gtk.Entry(placeholder_text="Ask anything about this computer…")
        self.entry.connect("activate", lambda _e: self.ask())
        box.pack_start(self.entry, False, False, 0)

        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.view = label("", selectable=True, xalign=0)
        self.view.set_line_wrap(True)
        self.view.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        self.view.set_valign(Gtk.Align.START)
        self.scroll.add(self.view)
        self.scroll.set_no_show_all(True)
        box.pack_start(self.scroll, True, True, 0)

        self.card_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.card_box.set_no_show_all(True)
        box.pack_start(self.card_box, False, False, 0)
        self.turn_start = 0

        self.chips = Gtk.FlowBox()  # suggested follow-up questions of the last answer
        self.chips.set_selection_mode(Gtk.SelectionMode.NONE)
        self.chips.set_min_children_per_line(1)
        self.chips.set_max_children_per_line(3)
        self.chips.set_homogeneous(False)
        self.chips.set_no_show_all(True)
        box.pack_start(self.chips, False, False, 0)

        self.status = label("", "dim")
        self.status.set_line_wrap(True)
        box.pack_start(self.status, False, False, 0)

        acts = Gtk.Box(spacing=8)
        self.cont = button("Continue in terminal", self.continue_terminal, "primary")
        self.cont.set_no_show_all(True)
        acts.pack_start(self.cont, False, False, 0)
        self.again = button("New question", self.new_question)
        self.again.set_no_show_all(True)
        acts.pack_start(self.again, False, False, 0)
        box.pack_start(acts, False, False, 0)

        more = Gtk.Box(spacing=8)
        more.pack_start(button("Work on repo…", self.work_on_repo), False, False, 0)
        more.pack_start(button("Diagnose last crash", lambda: self.jarvis("crash")), False, False, 0)
        more.pack_start(button("Open Claude", lambda: self.jarvis("open", "claude")), False, False, 0)
        more.pack_start(button("Open OpenCode", lambda: self.jarvis("open", "opencode")), False, False, 0)
        box.pack_start(more, False, False, 0)
        self.hint = label("Enter asks (a follow-up while an answer is open) · proposed changes run only when you press Run · Esc closes", "dim")
        box.pack_start(self.hint, False, False, 0)
        self.add(box)

    # ---- keys ---------------------------------------------------------------------------------------------------
    def on_key(self, _w, e):
        if e.keyval == Gdk.KEY_Escape:
            self.quit()
            return True
        return False

    def quit(self):
        self.stop()
        Gtk.main_quit()

    # ---- asking -------------------------------------------------------------------------------------------------
    def ask(self):
        q = self.entry.get_text().strip()
        if not q or self.proc:
            return
        target = self.agent.get_active_id() or "claude"
        if self.answer and target == self.last_target:
            self.follow(q)  # another question in the same conversation; "New question" starts afresh
            return
        self.last_target, self.session, self.answer = target, None, ""
        self.start(q)

    def follow(self, q):
        """Ask `q` as a follow-up: same conversation, shown under the previous answer."""
        if self.proc:
            return
        self.entry.set_text("")
        self.answer += f"\n\n**You:** {q}"
        self.start(q, follow_up=True)

    def start(self, prompt, follow_up=False):
        """Run the agent once; a follow-up (an action's result) continues the same conversation."""
        target = self.last_target
        self.clear_card()
        self.clear_chips()
        if target == "claude":
            cmd = ["claude", "-p", prompt, "--output-format", "stream-json", "--include-partial-messages",
                   "--verbose", "--append-system-prompt", INLINE_NOTE, "--add-dir", "/",
                   "--allowedTools", *READ_ONLY_TOOLS, "--disallowedTools", *SECRET_READS, *jcfg.claude_args()]
            if follow_up and self.session:
                cmd += ["--resume", self.session]
        elif follow_up:
            cmd = ["opencode", "run", "--continue", "--model", target, prompt]
        else:
            cmd = ["opencode", "run", "--model", target, f"{INLINE_NOTE}\n\nQuestion: {prompt}"]
        if follow_up:
            self.answer += "\n\n---\n\n"
        self.turn_start = len(self.answer)
        try:
            self.proc = subprocess.Popen(cmd, cwd=JDIR, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                         stdin=subprocess.DEVNULL, text=True, start_new_session=True)
        except OSError as e:
            self.set_status(f"Could not start {cmd[0]}: {e}", "bad")
            return
        self.started = time.time()
        self.entry.set_sensitive(False)
        self.agent.set_sensitive(False)
        self.cont.hide()
        self.again.hide()
        self.show_answer(self.answer)
        self.set_status("Checking the result…" if follow_up else "Thinking…")
        reader = self.read_claude if target == "claude" else self.read_plain
        threading.Thread(target=reader, args=(self.proc,), daemon=True).start()

    def read_claude(self, proc):
        """Claude stream-json: text deltas build the answer; tool calls show as status; result ends it."""
        for line in proc.stdout:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            t = e.get("type")
            if t == "system" and e.get("session_id"):
                GLib.idle_add(self.got_session, e["session_id"])
            elif t == "stream_event":
                ev = e.get("event") or {}
                if ev.get("type") == "content_block_delta" and (ev.get("delta") or {}).get("type") == "text_delta":
                    GLib.idle_add(self.add_text, ev["delta"].get("text", ""))
                elif ev.get("type") == "content_block_start":
                    block = ev.get("content_block") or {}
                    if block.get("type") == "tool_use":
                        GLib.idle_add(self.set_status, f"Looking: {block.get('name', 'tool')}…")
                    elif block.get("type") == "text" and self.answer and not self.answer.endswith("\n\n"):
                        GLib.idle_add(self.add_text, "\n\n")
            elif t == "result":
                GLib.idle_add(self.got_session, e.get("session_id"))
                if e.get("is_error"):
                    GLib.idle_add(self.set_status, str(e.get("result") or "The agent stopped with an error"), "bad")
        err = proc.stderr.read()
        GLib.idle_add(self.finished, proc, err)

    def read_plain(self, proc):
        for line in proc.stdout:
            GLib.idle_add(self.add_text, line)
        err = proc.stderr.read()
        GLib.idle_add(self.finished, proc, err)

    def got_session(self, sid):
        if sid:
            self.session = sid
        return False

    def add_text(self, text):
        self.answer += text
        self.show_answer(self.answer)
        if self.status.get_text().startswith(("Thinking", "Looking")):
            self.set_status("Answering…")
        return False

    def show_answer(self, md):
        md = FOLLOWUPS_RE.sub("", ACTION_RE.sub("", md)).rstrip()  # action blocks become cards, chips buttons
        self.view.set_markup(markdown_to_pango(md) if md else "")
        self.scroll.set_visible(bool(md))
        self.view.show()
        self.fit()
        adj = self.scroll.get_vadjustment()  # follow the text while it streams
        GLib.idle_add(lambda: adj.set_value(adj.get_upper()) and False)

    def fit(self):
        """Grow with the answer, but never past the screen: once per idle, however many changes came in."""
        if not self.fit_queued:
            self.fit_queued = True
            GLib.idle_add(self._fit)

    def _fit(self):
        self.fit_queued = False
        if self.scroll.get_visible():
            # Everything but the answer (title, box, card, buttons, status) is measured with the answer at 1 px;
            # the answer gets what is left of the screen, at least MIN_ANSWER.
            self.scroll.set_min_content_height(1)
            other = self.get_preferred_height_for_width(self.w)[1] - 1
            nat = self.view.get_preferred_height_for_width(self.w - 40)[1]
            self.scroll.set_min_content_height(max(1, min(nat, max(self.max_h - other, MIN_ANSWER))))
        self.resize(self.w, 1)  # shrink back too (a layer surface keeps its size otherwise)
        return False

    def finished(self, proc, err):
        if proc is not self.proc:
            return False
        rc = proc.wait()
        self.proc = None
        self.entry.set_sensitive(True)
        self.agent.set_sensitive(True)
        took = f"{time.time() - self.started:.0f} s"
        if rc == 0 or self.answer:
            if not self.status.get_style_context().has_class("bad"):
                self.set_status(f"Done · {took}")
        else:
            msg = (err or "").strip().splitlines()[-1:] or [f"exit {rc}"]
            self.set_status(f"The agent stopped: {msg[0][:200]}", "bad")
        self.cont.set_visible(bool(self.session) or self.last_target != "claude")
        self.again.show()
        actions = parse_actions(self.answer[self.turn_start:])
        if actions:
            self.show_card(actions[0])
            if not self.status.get_style_context().has_class("bad"):
                self.set_status(f"Done · {took} · nothing runs until you press Run")
        elif rc == 0 or self.answer:
            self.show_chips(parse_followups(self.answer[self.turn_start:]))
        self.entry.set_placeholder_text("Ask a follow-up…" if self.answer else "Ask anything about this computer…")
        self.entry.grab_focus()
        return False

    # ---- follow-up chips ----------------------------------------------------------------------------------------
    def clear_chips(self):
        for c in self.chips.get_children():
            self.chips.remove(c)
        self.chips.hide()

    def show_chips(self, questions):
        self.clear_chips()
        for q in questions:
            b = button(q, lambda q=q: self.follow(q))
            b.set_halign(Gtk.Align.START)
            self.chips.add(b)
        if questions:
            for c in self.chips.get_children():
                c.show_all()
            self.chips.show()  # no_show_all: show_all() would skip it
        self.fit()

    # ---- action cards -------------------------------------------------------------------------------------------
    def clear_card(self):
        for c in self.card_box.get_children():
            self.card_box.remove(c)
        self.card_box.hide()

    def show_card(self, a):
        self.clear_card()
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.get_style_context().add_class("item")
        card.pack_start(label(a["title"], "heading"), False, False, 0)
        grid = Gtk.Grid(column_spacing=12, row_spacing=4)
        for i, (k, v) in enumerate((("What", a["command"]), ("Why", a["why"]), ("How", a["how"]))):
            grid.attach(label(k, "dim", yalign=0), 0, i, 1, 1)
            val = label(v, selectable=True, xalign=0)
            val.set_line_wrap(True)
            val.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            val.set_hexpand(True)
            if k == "What":
                val.set_markup(f"<tt>{GLib.markup_escape_text(v)}</tt>")
            grid.attach(val, 1, i, 1, 1)
        card.pack_start(grid, False, False, 0)
        notes = []
        if a["root"]:
            notes.append("Runs as root: asks you to authenticate (password or fingerprint).")
        if DANGER_RE.search(a["command"]):
            notes.append("This can delete or overwrite data: check the command before you run it.")
        if notes:
            w = label(" ".join(notes), "warn" if not DANGER_RE.search(a["command"]) else "bad")
            w.set_line_wrap(True)
            card.pack_start(w, False, False, 0)
        row = Gtk.Box(spacing=8)
        self.run_btn = button("Run", lambda: self.run_action(a), "primary")
        self.skip_btn = button("Skip", lambda: self.skip_action(a))
        row.pack_start(self.run_btn, False, False, 0)
        row.pack_start(self.skip_btn, False, False, 0)
        card.pack_start(row, False, False, 0)
        self.card_out = label("", "dim", selectable=True, xalign=0, valign=Gtk.Align.START)
        self.card_out.set_line_wrap(True)
        self.card_out.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        self.out_scroll = Gtk.ScrolledWindow()  # long output scrolls inside the card instead of growing it
        self.out_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.out_scroll.set_propagate_natural_height(True)
        self.out_scroll.set_max_content_height(OUTPUT_MAX)
        self.out_scroll.add(self.card_out)
        self.out_scroll.set_no_show_all(True)
        card.pack_start(self.out_scroll, False, False, 0)
        self.card_box.pack_start(card, False, False, 0)
        card.show_all()        # the output stays hidden (no_show_all) until there is some
        self.card_box.show()   # show_all() does nothing on a no_show_all widget, so show it directly
        self.fit()

    def run_action(self, a):
        self.run_btn.set_sensitive(False)
        self.skip_btn.set_sensitive(False)
        self.entry.set_sensitive(False)
        self.set_status(f"Running: {a['title']}…")

        def work():
            try:
                argv = root_argv(a["command"]) if a["root"] else ["bash", "-c", a["command"]]
                limit = ROOT_TIMEOUT if a["root"] else RUN_TIMEOUT
                r = subprocess.run(argv, capture_output=True, text=True,
                                   timeout=limit, stdin=subprocess.DEVNULL, cwd=os.path.expanduser("~"))
                return r.returncode, (r.stdout + r.stderr)
            except subprocess.TimeoutExpired as e:
                out = (e.stdout or b"").decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
                return None, out + f"\n(stopped after {limit} s)"
            except OSError as e:
                return None, str(e)

        def done(res):
            rc, out = res
            out = (out or "").strip()
            shown = out if len(out) <= 3000 else out[:1500] + "\n…\n" + out[-1500:]
            self.card_out.set_markup("<tt>" + GLib.markup_escape_text(
                f"exit {rc if rc is not None else '—'}" + (f"\n{shown}" if shown else "")) + "</tt>")
            self.out_scroll.show_all()
            self.fit()
            self.answer += f"\n\n**Ran:** `{a['command']}` · exit {rc if rc is not None else 'none'}"
            self.start(f"I pressed Run. Command: {a['command']}\nExit code: {rc}\nOutput:\n```\n{shown}\n```\n"
                       "Check whether that worked. If more is needed, propose the next single step as an action "
                       "card; otherwise say briefly that it's done.", follow_up=True)
            return False

        threading.Thread(target=lambda: GLib.idle_add(done, work()), daemon=True).start()

    def skip_action(self, a):
        self.answer += f"\n\n*Skipped:* {a['title']}"
        self.start(f"I skipped that step ({a['title']}). Suggest another way, or stop if there isn't one.",
                   follow_up=True)

    def stop(self):
        p, self.proc = self.proc, None
        if p and p.poll() is None:
            try:
                os.killpg(p.pid, signal.SIGTERM)
            except OSError:
                pass

    def set_status(self, text, cls="dim"):
        ctx = self.status.get_style_context()
        for c in ("dim", "bad"):
            ctx.remove_class(c)
        ctx.add_class(cls)
        self.status.set_text(text)
        self.fit()  # a wrapped status line takes room too
        return False

    def new_question(self):
        self.stop()
        self.entry.set_text("")
        self.entry.set_sensitive(True)
        self.answer, self.session = "", None
        self.clear_card()
        self.clear_chips()
        self.entry.set_placeholder_text("Ask anything about this computer…")
        self.show_answer("")
        self.set_status("")
        self.cont.hide()
        self.again.hide()
        self.entry.grab_focus()

    # ---- the terminal side --------------------------------------------------------------------------------------
    def continue_terminal(self):
        if self.last_target == "claude" and self.session:
            launch("fw-term", "--class", "fw13.jarvis", "--hold", "--dir", JDIR, "-e",
                   "claude", *jcfg.claude_args(), "--resume", self.session, cwd=JDIR)
        elif self.last_target and self.last_target != "claude":
            launch("fw-term", "--class", "fw13.jarvis", "--hold", "--dir", JDIR, "-e",
                   "opencode", "--continue", "--model", self.last_target, cwd=JDIR)
        self.quit()

    def work_on_repo(self):
        text = self.entry.get_text().strip()
        if not text:
            self.set_status("Type what should change in fw13-hypr first, then press Work on repo…", "bad")
            self.entry.grab_focus()
            return
        self.jarvis("repo", self.agent.get_active_id() or "claude", text)

    def jarvis(self, *args):
        """Hand an action to fw-jarvis (terminal sessions, crash diagnosis), then close."""
        launch("fw-jarvis", *args)
        self.quit()


def main():
    args = sys.argv[1:]
    ask_now = args[1] if len(args) >= 2 and args[0] == "--ask" else None
    if ask_now:
        close_running()  # a diagnosis replaces an open panel instead of toggling it shut
    elif close_running():
        return 0
    subprocess.run(["pkill", "-x", "fuzzel"])  # close any open bar menu
    for gui in ("fw-display-panel", "fw-warp-panel", "fw-wallpaper"):
        close_pidfile(gui)
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    ui_theme.install()
    panel = Panel()
    panel.connect("destroy", lambda *_: panel.quit())
    try:
        from gi.repository import GLibUnix
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, panel.quit)
    except ImportError:
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, panel.quit)
    panel.show_all()
    panel.entry.grab_focus()
    if ask_now:  # fw-jarvis-panel --ask "…" (crash Diagnose): fill the box and start right away
        panel.entry.set_text(ask_now)
        GLib.idle_add(lambda: (panel.ask(), False)[1])
    try:
        Gtk.main()
    finally:
        panel.stop()
        try:
            if open(PIDFILE).read() == str(os.getpid()):
                os.remove(PIDFILE)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
