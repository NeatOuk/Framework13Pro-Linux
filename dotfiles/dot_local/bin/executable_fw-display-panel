#!/usr/bin/env python3
"""Display panel: laptop brightness slider, drag-to-arrange monitors, per-monitor refresh rate and scale.

Bar display icon (FW_BAR=1 → opens below the icon, a second click closes it). The editor itself lives in
~/.local/lib/fw13 (ui_display.DisplayEditor) and is shared with fw-settings' Display page: Apply uses
`hyprctl eval 'hl.monitor(...)'`, then asks to keep the change (reverts after 15 s); Keep saves
~/.config/hypr/displays.lua. GTK3 + gtk-layer-shell (python3-gobject, gtk-layer-shell).
"""
import json
import os
import signal
import subprocess
import sys

sys.path.insert(0, os.path.expanduser("~/.local/lib"))

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell  # noqa: E402

from fw13 import ui_theme  # noqa: E402
from fw13.hypr import hj  # noqa: E402
from fw13.ui_display import DisplayEditor  # noqa: E402

PANEL_W = 520
PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "fw-display-panel.pid")


# --- single instance: a second click on the icon closes the open panel -----------------------
def close_running():
    try:
        pid = int(open(PIDFILE).read())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if b"fw-display-panel" not in f.read():
                return False
        os.kill(pid, signal.SIGTERM)
        return True
    except (OSError, ValueError):
        return False


def right_margin():
    """Centre the panel under the pointer on the focused monitor, like fw-menu-anchor."""
    try:
        cx = json.loads(subprocess.run(["hyprctl", "-j", "cursorpos"], capture_output=True, text=True).stdout)["x"]
        m = next(m for m in hj("monitors") if m["focused"])
        return max(0, int(m["x"] + m["width"] / m["scale"] - cx - PANEL_W / 2))
    except (ValueError, KeyError, StopIteration):
        return 0


class Panel(Gtk.Window):
    def __init__(self, at_bar):
        super().__init__()
        self.get_style_context().add_class("panel")
        self.set_size_request(PANEL_W, -1)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "fw-display-panel")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        if at_bar:
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, right_margin())
        self.connect("key-press-event", lambda _w, e: e.keyval == Gdk.KEY_Escape and Gtk.main_quit())

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        for side in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{side}")(14)
        box.pack_start(ui_theme.label("Display", "title"), False, False, 0)
        self.editor = DisplayEditor()
        box.pack_start(self.editor, False, False, 0)
        self.add(box)


def main():
    if close_running():
        return
    at_bar = bool(os.environ.get("FW_BAR"))
    subprocess.run(["pkill", "-x", "fuzzel"])  # close any open bar menu
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))

    ui_theme.install()
    panel = Panel(at_bar)
    panel.connect("destroy", Gtk.main_quit)
    try:  # GLibUnix is the newer home of unix_signal_add
        from gi.repository import GLibUnix
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    except ImportError:
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    panel.show_all()
    try:
        Gtk.main()
    finally:
        if panel.editor.unconfirmed():  # closed while asking: don't keep an unconfirmed layout
            panel.editor.restore()
        try:
            if open(PIDFILE).read() == str(os.getpid()):
                os.remove(PIDFILE)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
