#!/usr/bin/env bash
# Bar VPN toggle for a strongSwan (swanctl) connection: fw-vpn --bar | toggle
# The connection is /etc/strongswan/swanctl/conf.d/<name>.conf (written by hand, root-only secrets) whose connection
# and child are both called <name>. No such file → the module stays hidden. Toggling runs the root wrapper
# /usr/local/bin/fw-vpn-ctl through pkexec; its polkit rule lets wheel in an active local session in without a
# password. Without the wrapper (older install) it falls back to pkexec swanctl, which asks each time.
set -euo pipefail

SIGNAL=13   # waybar custom/vpn "signal"

# shortcut: only the first connection file is used; add a picker if a second VPN ever appears
conn() {
  local f
  for f in /etc/strongswan/swanctl/conf.d/*.conf; do
    [[ -e $f ]] && { basename "$f" .conf; return 0; }
  done
  return 1
}

# charon installs the tunnel's routes in table 220, which is readable without root: none = down.
# Before the first connect since boot the table doesn't exist and `ip` exits 2, which pipefail would turn fatal.
routes() { { ip -4 route show table 220 2>/dev/null || true; } | awk '{ print $1 }' | paste -sd ' '; }

case ${1:-} in
  --bar)
    name="$(conn)" || { echo '{"text": ""}'; exit 0; }
    nets="$(routes)"
    if [[ -n $nets ]]; then
      printf '{"text": "", "class": "connected", "tooltip": "VPN %s: connected\\n%s"}\n' "$name" "$nets"
    else
      printf '{"text": "", "class": "off", "tooltip": "VPN %s: off (click to connect)"}\n' "$name"
    fi
    ;;
  toggle)
    name="$(conn)" || exit 0
    if [[ -n $(routes) ]]; then
      args=(--terminate --ike "$name") verb=disconnect ctl=down
    else
      args=(--initiate --child "$name") verb=connect ctl=up
    fi
    if [[ -x /usr/local/bin/fw-vpn-ctl ]]; then cmd=(/usr/local/bin/fw-vpn-ctl "$ctl"); else cmd=(/usr/bin/swanctl "${args[@]}"); fi
    pkexec "${cmd[@]}" >/dev/null 2>&1 \
      || fw-notify "VPN $name" "Could not $verb (cancelled, or see: journalctl -u strongswan)"
    pkill -RTMIN+"$SIGNAL" -x waybar || true
    ;;
  *) echo "usage: fw-vpn --bar | toggle" >&2; exit 2 ;;
esac
