#!/usr/bin/env python3
"""Calculator (SUPER+equal): a fuzzel prompt "= " that answers in its message line.

Type a sum and press Enter: the answer appears above the prompt, the sum stays in the box to edit. Enter again on the
same sum (or on an empty box) copies the answer and closes; Esc closes without copying.

Sums go to qalc (libqalculate: units, currencies, percentages, "10 km to mi") as one argv item, never through a shell.
Without qalc a small built-in evaluator does plain maths (+ - * / // % ^, brackets, pi, e, sqrt, sin, log…) with
limits on input length, size of numbers and work, so a typo can't hang the session.

  fw-calc                 the prompt
  fw-calc --eval <sum>    print the answer (or "error: …") and exit; for scripts and tests
"""
import ast
import math
import os
import re
import shutil
import subprocess
import sys
import time

MAX_INPUT = 200         # characters
MAX_NODES = 100         # AST nodes in one sum
MAX_BITS = 13_000       # integer size (about 3 900 digits; Python prints at most 4 300)
MAX_FACTORIAL = 1000
QALC_TIMEOUT = 5        # s; currency updates are qalc's own business, a stuck one just gives an error
PLACEHOLDER = "2^10, 15% of 80, 10 km to mi"


class CalcError(Exception):
    pass


def _int_ok(v):
    if isinstance(v, int) and v.bit_length() > MAX_BITS:
        raise CalcError("number too large")
    return v


def _pow(a, b):
    if isinstance(a, int) and isinstance(b, int) and b > 0 and abs(a) > 1 and b * (abs(a).bit_length() - 1) > MAX_BITS:
        raise CalcError("number too large")
    if isinstance(b, (int, float)) and abs(b) > 1e6 and isinstance(a, int):
        raise CalcError("exponent too large")
    v = a ** b
    if isinstance(v, complex):  # (-8)^(1/3): Python goes complex, a calculator should say so
        raise CalcError("no real answer")
    return v


def _factorial(n):
    if not (isinstance(n, int) or (isinstance(n, float) and n.is_integer())) or n < 0:
        raise CalcError("factorial needs a whole number ≥ 0")
    if n > MAX_FACTORIAL:
        raise CalcError(f"factorial limit is {MAX_FACTORIAL}")
    return math.factorial(int(n))


def _deg(fn):
    return lambda x: fn(math.radians(x))


BINOPS = {
    ast.Add: lambda a, b: a + b, ast.Sub: lambda a, b: a - b, ast.Mult: lambda a, b: a * b,
    ast.Div: lambda a, b: a / b, ast.FloorDiv: lambda a, b: a // b, ast.Mod: lambda a, b: a % b, ast.Pow: _pow,
}
UNARY = {ast.UAdd: lambda a: +a, ast.USub: lambda a: -a}
NAMES = {"pi": math.pi, "π": math.pi, "e": math.e, "tau": math.tau, "inf": math.inf}
FUNCS = {
    "sqrt": math.sqrt, "cbrt": lambda x: math.copysign(abs(x) ** (1 / 3), x), "abs": abs, "round": round,
    "floor": math.floor, "ceil": math.ceil, "exp": math.exp, "ln": math.log, "log": math.log, "log10": math.log10,
    "log2": math.log2, "sin": math.sin, "cos": math.cos, "tan": math.tan, "asin": math.asin, "acos": math.acos,
    "atan": math.atan, "sind": _deg(math.sin), "cosd": _deg(math.cos), "tand": _deg(math.tan),
    "factorial": _factorial, "min": min, "max": max,
}


def _eval(node):
    if isinstance(node, ast.Expression):
        return _eval(node.body)
    if isinstance(node, ast.Constant) and type(node.value) in (int, float):
        return _int_ok(node.value)
    if isinstance(node, ast.BinOp) and type(node.op) in BINOPS:
        return _int_ok(BINOPS[type(node.op)](_eval(node.left), _eval(node.right)))
    if isinstance(node, ast.UnaryOp) and type(node.op) in UNARY:
        return UNARY[type(node.op)](_eval(node.operand))
    if isinstance(node, ast.Name) and node.id in NAMES:
        return NAMES[node.id]
    if (isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in FUNCS
            and not node.keywords and 0 < len(node.args) <= 2):
        return _int_ok(FUNCS[node.func.id](*[_eval(a) for a in node.args]))
    if isinstance(node, ast.Name):
        raise CalcError(f"unknown name: {node.id}")
    raise CalcError("only numbers, + - * / // % ^ and maths functions")


def builtin_eval(expr):
    """Plain maths without qalc. Returns the answer as text; raises CalcError."""
    expr = expr.strip()
    if len(expr) > MAX_INPUT:
        raise CalcError("too long")
    expr = expr.replace("^", "**").replace("×", "*").replace("÷", "/").replace("−", "-").replace("·", "*")
    # "5!" / "(2+3)!" → factorial(…) for the number or innermost bracket just before the "!", not the whole sum
    expr = re.sub(r"(\d+(?:\.\d+)?|\([^()]*\))\s*!", r"factorial(\1)", expr)
    try:
        tree = ast.parse(expr, mode="eval")
    except (SyntaxError, ValueError):
        raise CalcError("can't read that") from None
    if sum(1 for _ in ast.walk(tree)) > MAX_NODES:
        raise CalcError("too long")
    try:
        v = _eval(tree)
    except ZeroDivisionError:
        raise CalcError("division by zero") from None
    except OverflowError:
        raise CalcError("number too large") from None
    except (ValueError, TypeError) as e:
        raise CalcError(str(e) or "math error") from None
    if isinstance(v, float):
        if v.is_integer() and abs(v) < 1e15:
            return str(int(v))
        return f"{v:.12g}"
    return str(v)


def qalc_eval(expr):
    """`qalc -t <expr>`; returns the answer text; raises CalcError with qalc's message."""
    # A leading space keeps a sum such as "-5+3" from being read as an option.
    try:
        r = subprocess.run(["qalc", "-t", " " + expr], capture_output=True, text=True, timeout=QALC_TIMEOUT,
                           stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise CalcError("qalc took too long") from None
    lines = [ln.strip() for ln in (r.stdout + "\n" + r.stderr).splitlines() if ln.strip()]
    errors = [ln for ln in lines if ln.lower().startswith(("error:", "warning:"))]
    answers = [ln for ln in lines if ln not in errors]
    if r.returncode != 0 or not answers:
        raise CalcError((errors[0].split(":", 1)[1].strip() if errors else "") or "can't read that")
    return answers[-1]


def evaluate(expr):
    """(answer, None) or (None, error)."""
    try:
        if shutil.which("qalc"):
            return qalc_eval(expr), None
        return builtin_eval(expr), None
    except CalcError as e:
        return None, str(e)


def copy_text(ans):
    """What goes on the clipboard: the bare number ("≈ 3.14" → "3.14", "= 4" → "4")."""
    for p in ("≈", "=", "approx."):
        if ans.startswith(p):
            ans = ans[len(p):].strip()
    return ans


def fuzzel_free():
    """fuzzel allows one instance (lock in $XDG_RUNTIME_DIR): wait for the previous menu to exit, at most 2 s."""
    for _ in range(40):
        if subprocess.run(["pgrep", "-x", "fuzzel"], stdout=subprocess.DEVNULL).returncode != 0:
            return
        time.sleep(0.05)


def ask(mesg, text):
    fuzzel_free()
    cmd = ["fuzzel", "--dmenu", "--prompt-only", "= ", "--width", "50", "--placeholder", PLACEHOLDER]
    if mesg:
        cmd += ["--mesg", mesg]
    if text:
        cmd += ["--search", text]
    r = subprocess.run(cmd, capture_output=True, text=True)
    return r.stdout.rstrip("\n") if r.returncode == 0 else None


def run():
    note = "" if shutil.which("qalc") else "(qalc missing: plain maths only)"
    expr = ans = None
    mesg = note
    while True:
        typed = ask(mesg, expr)
        if typed is None:
            return 0  # Esc
        typed = typed.strip()
        if ans is not None and typed in ("", expr):
            subprocess.run(["wl-copy", "--", copy_text(ans)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return 0
        if not typed:
            return 0
        expr = typed
        ans, err = evaluate(expr)
        if ans is not None:
            mesg = f"{expr} = {copy_text(ans)}\nEnter copies it"
        else:
            mesg = f"{err}" + (f"\n{note}" if note else "")


def main(argv):
    if argv[:1] == ["--eval"] and len(argv) == 2:
        ans, err = evaluate(argv[1])
        print(ans if ans is not None else f"error: {err}")
        return 0 if ans is not None else 1
    if argv:
        print("usage: fw-calc [--eval <sum>]", file=sys.stderr)
        return 2
    return run()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
