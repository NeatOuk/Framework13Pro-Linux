#!/usr/bin/env bash
# Jarvis: ask an AI agent — Claude Code, or OpenCode on any Ollama server from the OpenCode panel — about
# this computer or the fw13-hypr repo. Tasks open in a floating kitty window (class fw-jarvis).
#   fw-jarvis                  the Jarvis panel (SUPER+A): ask and the answer appears inline (fw-jarvis-panel)
#   fw-jarvis menu             the older fuzzel menu
#   fw-jarvis crash | repo <agent> <task> | open claude|opencode   the panel's buttons
#   fw-jarvis diagnose <file>  explain a crash report (fw-crash-watch) or a daily health report (fw-health)
# Ask/Diagnose run in ~/jarvis (created if missing), whose AGENTS.md/CLAUDE.md brief the agent on this OS.
set -euo pipefail

JDIR="$HOME/jarvis"
mkdir -p "$JDIR"
CRASHES="${XDG_RUNTIME_DIR:-/tmp}/jarvis"
REPO="$HOME/.local/share/fw13-hypr"
for d in "$HOME/fw13-hyprland" "$HOME/Framework13Pro-Linux"; do   # owner's clone (new name, old name)
  [[ -d $d/.git ]] && { REPO=$d; break; }
done

mkdir -p "$CRASHES"
LOG="$CRASHES/jarvis.log"
log() { printf '%s %s\n' "$(date +%T)" "$*" >> "$LOG"; }  # each step, so "nothing happened" can be traced

pos=()
if [[ -n ${FW_BAR:-} ]]; then
  mapfile -t pos < <(fw-menu-anchor jarvis)
  (( ${#pos[@]} )) || exit 0
fi

# fuzzel allows one instance (a lock in $XDG_RUNTIME_DIR): the next prompt fails silently if the previous menu
# hasn't exited yet. Wait for it, at most 2 s.
fuzzel_free() { local _; for _ in {1..40}; do pgrep -x fuzzel >/dev/null || return 0; sleep 0.05; done; }
menu() { fuzzel_free; local rc=0 out; out="$(fuzzel --dmenu "${pos[@]}" --prompt "$1 › " --lines "${2:-8}")" || rc=$?
         log "menu '$1' rc=$rc -> '$out'"; printf '%s' "$out"; return "$rc"; }
ask()  { fuzzel_free; local rc=0 out; out="$(fuzzel --dmenu "${pos[@]}" --prompt-only "$1 › " </dev/null)" || rc=$?
         log "ask '$1' rc=$rc -> ${#out} chars"; printf '%s' "$out"; return "$rc"; }

# "label<TAB>target": claude, or provider/model for OpenCode (active server first).
agents() {
  printf 'Claude\tclaude\n'
  fw-opencode --list 2>/dev/null || true
}

pick_agent() {
  local list label
  mapfile -t list < <(agents)
  if (( ${#list[@]} == 1 )); then  # only Claude (no Ollama servers yet): no menu for a single choice
    printf '%s\n' "${list[0]#*$'\t'}"
    return 0
  fi
  label="$(printf '%s\n' "${list[@]}" | cut -f1 | menu "Agent" "${#list[@]}")" || return 1
  printf '%s\n' "${list[@]}" | awk -F'\t' -v l="$label" '$1 == l { print $2; exit }'
}

# launch <dir> <target> [prompt] — with a prompt it's a Jarvis task (floating window, class fw-jarvis);
# without one it's a plain Claude/OpenCode session that tiles like any terminal.
launch() {
  local dir=$1 target=$2 prompt=${3:-} cmd class=()
  if [[ $target == claude ]]; then cmd=(claude ${prompt:+"$prompt"})
  elif [[ $target == opencode ]]; then cmd=(opencode ${prompt:+--prompt "$prompt"})
  else cmd=(opencode --model "$target" ${prompt:+--prompt "$prompt"}); fi
  # Tasks keep their window when the agent exits (--hold), so an error stays readable instead of a window
  # that flashes and closes.
  [[ -n $prompt ]] && class=(--class fw-jarvis --hold)
  log "launch in $dir: ${cmd[0]} (${#prompt} chars of prompt)"
  uwsm app -- kitty "${class[@]}" --directory "$dir" -e "${cmd[@]}" >>"$LOG" 2>&1 &
}

diagnose() {
  local file=$1
  [[ -r $file ]] || { fw-notify "Jarvis" "Report not found"; return; }
  # The Jarvis panel answers inline and right away; fixes come as Run/Skip cards (nothing runs without a click).
  exec fw-jarvis-panel --ask "Read the report at $file (a crash report or a daily health report), then check \
whatever else helps (journalctl, coredumpctl info, the app's own log files). Explain in plain words what needs \
attention and the most likely cause. If there's a fix, propose it as action cards, one step at a time."
}

main() {
  local pick text target last
  pick="$(printf '%s\n' \
    $'  Ask…' $'  Work on the fw13-hypr repo…' $'  Diagnose last crash' \
    $'✱  Open Claude' $'  Open OpenCode' | menu Jarvis 5)" || return 0
  case $pick in
    *Ask*)
      text="$(ask "Ask Jarvis")" || return 0
      [[ -n $text ]] || return 0
      target="$(pick_agent)" || return 0
      launch "$JDIR" "$target" "$text" ;;
    *repo*)
      text="$(ask "What should change in fw13-hypr")" || return 0
      [[ -n $text ]] || return 0
      target="$(pick_agent)" || return 0
      launch "$REPO" "$target" "$text" ;;
    *crash*) last_crash ;;
    *Claude*)   launch "$HOME" claude ;;
    *OpenCode*) launch "$HOME" opencode ;;
  esac
}

last_crash() {
  local last
  last="$(ls -t "$CRASHES"/crash-*.md 2>/dev/null | head -1)" || true
  if [[ -n $last ]]; then diagnose "$last"; else fw-notify "Jarvis" "No crash reports since login"; fi
}

# No argument: the Jarvis panel (inline answers; fw-jarvis-panel). Its buttons come back here.
case ${1:-} in
  "")       exec fw-jarvis-panel ;;
  menu)     main ;;                                   # the old fuzzel menu
  diagnose) diagnose "${2:?usage: fw-jarvis diagnose <file>}" ;;
  crash)    last_crash ;;
  repo)     launch "$REPO" "${2:?usage: fw-jarvis repo <agent> <task>}" "${3:?usage: fw-jarvis repo <agent> <task>}" ;;
  open)     launch "$HOME" "${2:-claude}" ;;
  *) echo "usage: fw-jarvis [menu | diagnose <file> | crash | repo <agent> <task> | open claude|opencode]" >&2; exit 2 ;;
esac
