#!/usr/bin/env bash
# Control center (fuzzel). Bar sliders icon opens the main menu; bar icons open a section directly:
#   fw-control-center [volume|wifi|bluetooth]
# Uses only what's installed: wpctl, nmcli, bluetoothctl. Power → fw-power-panel.
set -euo pipefail

# Bar clicks set FW_BAR=1: open the menu below the clicked icon, closing any other menu (or this
# one, on a second click). From the keyboard it stays centred.
pos=()
if [[ -n ${FW_BAR:-} ]]; then
  mapfile -t pos < <(fw-menu-anchor "control-${1:-main}")
  (( ${#pos[@]} )) || exit 0
fi

menu() { fuzzel --dmenu "${pos[@]}" --prompt "$1 › " --lines "${2:-8}"; }

volume() {
  local cur pick
  cur="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d%%%s", int($2 * 100 + 0.5), ($3 ? " muted" : "")}')"
  pick="$(printf '%s\n' "Mute on/off" 100% 75% 50% 25% "Advanced…" | menu "Volume $cur" 6)" || return 0
  case $pick in
    Mute*) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    Adv*)  uwsm app -- pavucontrol ;;
    *)     wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$pick" ;;
  esac
}

wifi() {
  local radio toggle nets pick ssid pw
  radio="$(nmcli radio wifi)"
  [[ $radio == enabled ]] && toggle="Turn Wi-Fi off" || toggle="Turn Wi-Fi on"
  # "● 87%  Name" per network, strongest first, one line per SSID (-e no: SSIDs keep their colons).
  # Cached list so the menu opens instantly; a background rescan freshens it for next time.
  nmcli dev wifi rescan >/dev/null 2>&1 &
  nets="$(nmcli -t -e no -f IN-USE,SIGNAL,SSID dev wifi list --rescan no 2>/dev/null \
    | awk -F: '{ s = substr($0, length($1) + length($2) + 3) } s != "" && !seen[s]++ {
        printf "%s %3s%%  %s\n", ($1 == "*" ? "●" : " "), $2, s }')"
  pick="$(printf '%s\n%s\n%s' "$toggle" "Advanced…" "$nets" | sed '/^$/d' | menu Wi-Fi 12)" || return 0
  case $pick in
    "Turn Wi-Fi off") nmcli radio wifi off; return ;;
    "Turn Wi-Fi on")  nmcli radio wifi on; return ;;
    Adv*)             uwsm app -- nm-connection-editor; return ;;
  esac
  ssid="${pick#*%  }"  # strip "● 87%  "
  if nmcli -g NAME connection show | grep -Fxq -- "$ssid"; then
    nmcli connection up id "$ssid" >/dev/null && fw-notify "Wi-Fi" "Connected to $ssid" || fw-notify "Wi-Fi" "Could not connect to $ssid"
    return
  fi
  pw="$(fuzzel --dmenu "${pos[@]}" --password --prompt "Password for $ssid › " --lines 0)" || return 0
  if nmcli dev wifi connect "$ssid" ${pw:+password "$pw"} >/dev/null; then
    fw-notify "Wi-Fi" "Connected to $ssid"
  else
    fw-notify "Wi-Fi" "Could not connect to $ssid"
  fi
}

bluetooth() {
  local power pick
  power="$(bluetoothctl show | awk '/Powered:/ {print $2; exit}')"
  pick="$(printf '%s\n' "Turn $([[ $power == yes ]] && echo off || echo on)" "Devices…" | menu Bluetooth 2)" || return 0
  case $pick in
    Turn*) bluetoothctl power "${pick#Turn }" >/dev/null ;;
    Dev*)  uwsm app -- blueman-manager ;;
  esac
}

main() {
  local pick
  pick="$(printf '%s\n' \
    $'  Volume' $'  Wi-Fi' $'  Bluetooth' \
    $'  Power' $'  Night light' $'  Lock / Suspend / Shut down' \
    | menu Control 6)" || return 0
  case $pick in
    *Volume)     volume ;;
    *Wi-Fi)      wifi ;;
    *Bluetooth)  bluetooth ;;
    *Power)      fw-power-panel ;;
    *Night*)     fw-nightlight ;;
    *Shut*)      fw-system-menu ;;
  esac
}

case ${1:-} in
  "")                                     main ;;
  volume|wifi|bluetooth) "$1" ;;
  *) echo "usage: fw-control-center [volume|wifi|bluetooth]" >&2; exit 2 ;;
esac
