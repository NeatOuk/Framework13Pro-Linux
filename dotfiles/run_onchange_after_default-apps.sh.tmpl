#!/bin/sh
# Default apps + GNOME apps hidden from the launcher in Hyprland (fw13.defaultapps); also runs at every Hyprland
# login (autostart.lua). Rerun by chezmoi when the module changes:
# defaultapps.py hash: {{ include "dot_local/lib/fw13/defaultapps.py" | sha256sum }}
command -v python3 >/dev/null 2>&1 || exit 0
PYTHONPATH="$HOME/.local/lib" python3 -m fw13.defaultapps || true
