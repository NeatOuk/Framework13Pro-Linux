#!/usr/bin/env bash
# Run once per user after the first login:  fw13-firstboot
# Distro-agnostic: the same script works on Arch/other distros as long as
# mise is installed (everything below lives in $HOME).
set -euo pipefail

DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/NeatOuk/Framework13Pro-Linux}"
say() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }

# 1. Login shell picker -----------------------------------------------------
say "Pick your login shell"
choices=()
for s in zsh fish bash; do command -v "$s" >/dev/null && choices+=("$s"); done
PS3="Shell [1-${#choices[@]}]: "
select SHELL_PICK in "${choices[@]}"; do [[ -n "${SHELL_PICK:-}" ]] && break; done
SHELL_PATH="$(command -v "$SHELL_PICK")"
if [[ "$(getent passwd "$USER" | cut -d: -f7)" != "$SHELL_PATH" ]]; then
  sudo usermod --shell "$SHELL_PATH" "$USER"
fi

# 2. mise: runtimes + user tools (chezmoi, starship, claude code) -----------
say "Installing tools with mise"
command -v mise >/dev/null || { echo "mise not found"; exit 1; }
eval "$(mise activate bash)"

# 3. Dotfiles ---------------------------------------------------------------
say "Applying dotfiles with chezmoi"
if [[ -z "$DOTFILES_REPO" ]]; then
  read -rp "Dotfiles git repo (e.g. github.com/NeatOuk/Framework13Pro-Linux): " DOTFILES_REPO
fi
mise exec chezmoi@latest -- chezmoi init --apply "$DOTFILES_REPO"

# dotfiles ship ~/.config/mise/config.toml (incl. npm:@anthropic-ai/claude-code)
mise install node
mise install

# 4. Flathub (remote only — apps are installed one by one, by you) ----------
say "Adding Flathub remote (no apps installed)"
flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# 5. Fingerprint -------------------------------------------------------------
if command -v fprintd-enroll >/dev/null; then
  read -rp "Enroll a fingerprint now? [y/N] " yn
  [[ "${yn,,}" == y ]] && fprintd-enroll
fi

# 6. Timeshift snapshots of /var/home ----------------------------------------
read -rp "Set up Timeshift snapshots of /var/home now? [Y/n] " yn
[[ "${yn,,}" != n ]] && { fw-timeshift-setup || echo "Re-run later: sudo fw-timeshift-setup"; }

# 7. Firmware ---------------------------------------------------------------
say "Checking Framework firmware (LVFS)"
fwupdmgr refresh --force >/dev/null 2>&1 || true
fwupdmgr get-updates || true

say "Done. Log out and back in to start Hyprland with the new shell + env."
