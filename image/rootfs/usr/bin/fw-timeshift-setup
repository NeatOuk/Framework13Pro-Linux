#!/usr/bin/env bash
# One-time Timeshift setup for an image-based (bootc) system.
# Timeshift runs in rsync mode and snapshots ONLY /var/home (+ /etc).
# The OS in /usr is the read-only image — roll that back with `bootc rollback`, never Timeshift.
set -euo pipefail
[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

echo "Devices Timeshift can store snapshots on:"
timeshift --list-devices || true
echo
echo "Pick a SECOND drive/partition if you have one (protects against disk failure)."
echo "Using the system disk works too, but only protects against deletion/mistakes."
read -rp "Device to use (e.g. /dev/nvme0n1p3): " DEV
UUID="$(blkid -s UUID -o value "$DEV")"
[[ -n "$UUID" ]] || { echo "No UUID for $DEV"; exit 1; }

mkdir -p /etc/timeshift
cat > /etc/timeshift/timeshift.json <<JSON
{
  "backup_device_uuid" : "$UUID",
  "parent_device_uuid" : "",
  "do_first_run" : "false",
  "btrfs_mode" : "false",
  "include_btrfs_home_for_backup" : "false",
  "include_btrfs_home_for_restore" : "false",
  "stop_cron_emails" : "true",
  "schedule_monthly" : "false",
  "schedule_weekly" : "true",
  "schedule_daily" : "true",
  "schedule_hourly" : "true",
  "schedule_boot" : "false",
  "count_monthly" : "2",
  "count_weekly" : "4",
  "count_daily" : "7",
  "count_hourly" : "12",
  "count_boot" : "3",
  "exclude" : [
    "/var/home/*/.cache/***",
    "/var/home/*/.local/share/Steam/***",
    "/var/home/*/.local/share/mise/***",
    "/var/home/*/.local/share/containers/***",
    "/var/home/*/.local/share/Trash/***",
    "/var/home/*/Downloads/***",
    "/var/home/*/.var/app/*/cache/***",
    "+ /var/",
    "+ /var/home/***",
    "+ /etc/***",
    "/var/*",
    "/*"
  ],
  "exclude-apps" : []
}
JSON
echo "Config written to /etc/timeshift/timeshift.json"
timeshift --create --comments "baseline after setup" --scripted
timeshift --list
echo
echo "Check the first snapshot contains only etc/ and var/home/ (rsync filter order: first match wins)."
echo
echo "Schedule: hourly x12, daily x7, weekly x4 (systemd timer fw-timeshift.timer)."
echo "Browse/restore single files: open the snapshot folder in Thunar (timeshift --list shows paths)."
echo "Do NOT use Timeshift's full-system 'Restore' on this OS — use bootc rollback for the OS."
