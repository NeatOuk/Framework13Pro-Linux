# Framework 13 Pro · Fedora bootc · Hyprland
# Build:   ./scripts/build-image.sh
# Deploy:  sudo bootc switch ghcr.io/<you>/fw13-hypr:latest   (or ./scripts/switch-local.sh)

ARG FEDORA_VERSION=44
FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

# Single swap point for the Hyprland source. Set to "" to use Fedora repos only.
ARG HYPR_COPR=lionheartp/Hyprland

COPY repos/    /etc/yum.repos.d/
COPY packages/ /tmp/packages/
COPY build.sh  /tmp/build.sh
COPY rootfs/   /

RUN HYPR_COPR="${HYPR_COPR}" bash /tmp/build.sh && \
    rm -rf /tmp/* /var/cache/* /var/log/* /var/lib/dnf && \
    bootc container lint
